# Server Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Security & Authentication
# Generate a strong 256-bit random key for production
JWT_SECRET=replace_with_a_long_random_secret_mitwpu_2026_jwt_token

# Database Mode Selection:
# Leave DB_HOST blank to use the built-in, zero-setup atomic local JSON database.
# To connect to MySQL / phpMyAdmin, provide credentials below:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=edupredict

# Python FastAPI Machine Learning Microservice
FASTAPI_URL=http://127.0.0.1:8000
